{
	"name": "df_inventario_diario",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "inventario_diario_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "inventario_diario",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          inventario_id as string,",
				"          fecha_inventario as string,",
				"          sucursal_id as string,",
				"          producto_id as string,",
				"          stock_inicial as string,",
				"          entradas as string,",
				"          salidas as string,",
				"          stock_final as string,",
				"          punto_reorden as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(fecha_inventario = toDate(fecha_inventario),",
				"          stock_inicial = toInteger(stock_inicial),",
				"          stock_final = toInteger(stock_final),",
				"          entradas = toInteger(entradas),",
				"          salidas = toInteger(salidas),",
				"          punto_reorden = toInteger(punto_reorden)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          inventario_id as string,",
				"          fecha_inventario as date,",
				"          sucursal_id as string,",
				"          producto_id as string,",
				"          stock_inicial as integer,",
				"          entradas as integer,",
				"          salidas as integer,",
				"          stock_final as integer,",
				"          punto_reorden as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}